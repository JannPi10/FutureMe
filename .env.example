# Variables de entorno — FutureMe by Leidy Sabata
# Copia este archivo como .env.local y completa los valores

# ──────────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────────
# Obtén estas claves en: https://supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Service role key — SOLO para el servidor (admin). NUNCA expongas esto en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────
# NEXTAUTH
# ──────────────────────────────────────────────
# En producción: URL de tu sitio en Vercel (ej: https://futureme.vercel.app)
NEXTAUTH_URL=http://localhost:3000
# Genera un secreto seguro con: openssl rand -base64 32
NEXTAUTH_SECRET=tu_secreto_super_seguro_aqui

# ──────────────────────────────────────────────
# PANEL DE ADMINISTRACIÓN
# ──────────────────────────────────────────────
# Credenciales del administrador
ADMIN_EMAIL=admin@futureme.co
ADMIN_PASSWORD=TuPasswordSegura2024!

# ──────────────────────────────────────────────
# CONFIGURACIÓN DE LA TIENDA (valores por defecto)
# ──────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=FutureMe by Leidy Sabata
NEXT_PUBLIC_WHATSAPP=+573001234567
